{
  "name": "dsh-taffy-boot",
  "version": "1.0.7",
  "description": "永雏塔菲主题的 DeepSeek Harness 启动动画（原生 Cordis 插件）：原版图标启动即在首帧播放塔菲片头，可跳过、可还原",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack": "node scripts/build.mjs --pack",
    "install:plugin": "node scripts/install.mjs",
    "test": "node scripts/test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "boot-animation",
    "splash",
    "taffy",
    "cordis"
  ],
  "license": "MIT"
}
